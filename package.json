{
  "name": "document-vault",
  "version": "1.0.0",
  "description": "Document Vault GraphQL API built with Bun, TypeScript, GraphQL Yoga, PostgreSQL, and Prisma",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "bun test",
    "sanity": "bun run lint && bun run typecheck && bun run test",
    "gendb": "prisma generate && prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "keywords": [
    "graphql",
    "bun",
    "typescript",
    "prisma",
    "postgresql",
    "graphql-yoga"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.4.0",
    "graphql": "^16.10.0",
    "graphql-yoga": "^5.13.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^22.13.5",
    "prisma": "^6.4.0",
    "typescript": "^5.7.3"
  }
}
